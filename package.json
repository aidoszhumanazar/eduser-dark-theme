{
  "name": "eduser-dark-theme",
  "displayName": "EDUSER Dark Theme",
  "description": "Rich, saturated VS Code dark theme for the EDUSER ecosystem. Calm indigo-blue background with vivid syntax colors, optimized for SQL, HTML, CSS, JavaScript and Python.",
  "version": "0.1.3",
  "publisher": "eduser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aidoszhumanazar/eduser-dark-theme.git"
  },
  "homepage": "https://github.com/aidoszhumanazar/eduser-dark-theme#readme",
  "bugs": {
    "url": "https://github.com/aidoszhumanazar/eduser-dark-theme/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "keywords": [
    "theme",
    "dark theme",
    "eduser",
    "education",
    "python",
    "javascript",
    "sql",
    "html",
    "css"
  ],
  "galleryBanner": {
    "color": "#171A2D",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "EDUSER Dark Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/eduser-dark-color-theme.json"
      }
    ]
  },
  "scripts": {
    "validate": "node -e \"const fs=require('fs'); JSON.parse(fs.readFileSync('package.json','utf8')); JSON.parse(fs.readFileSync('themes/eduser-dark-color-theme.json','utf8')); console.log('JSON validation passed');\"",
    "package": "vsce package"
  }
}
