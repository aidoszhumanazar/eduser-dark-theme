  "tokenColors": [
    {
      "name": "HTML tags",
      "scope": [
        "entity.name.tag.html"
      ],
      "settings": {
        "foreground": "#FF3D6E"
      }
    },
    {
      "name": "HTML attributes",
      "scope": [
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#2BEE7A"
      }
    },
    {
      "name": "HTML strings",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#4FA3FF"
      }
    },
    {
      "name": "HTML comments",
      "scope": [
        "comment.block.html",
        "comment.line.html"
      ],
      "settings": {
        "foreground": "#7479A3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#DCDEF2"
      }
    },
    {
      "name": "CSS property names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "meta.attribute.style.html source.css"
      ],
      "settings": {
        "foreground": "#D16BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css",
        "constant.other.color.hex.css"
      ],
      "settings": {
        "foreground": "#FFA132",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript base text and variables",
      "scope": [
        "source.js variable",
        "source.js variable.other.readwrite",
        "source.jsx variable",
        "source.jsx variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DCDEF2",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript keywords",
      "scope": [
        "source.js keyword",
        "source.js storage.type",
        "source.js storage.modifier",
        "source.js keyword.control.async",
        "source.js keyword.control.await",
        "source.js keyword.control.import",
        "source.js keyword.control.export",
        "source.jsx keyword",
        "source.jsx storage.type",
        "source.jsx storage.modifier"
      ],
      "settings": {
        "foreground": "#D16BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript functions",
      "scope": [
        "source.js entity.name.function",
        "source.js support.function",
        "source.js meta.function-call",
        "source.jsx entity.name.function",
        "source.jsx meta.function-call"
      ],
      "settings": {
        "foreground": "#6E8BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript parameters",
      "scope": [
        "source.js variable.parameter",
        "source.jsx variable.parameter"
      ],
      "settings": {
        "foreground": "#DCDEF2",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript this",
      "scope": [
        "source.js variable.language.this",
        "source.jsx variable.language.this"
      ],
      "settings": {
        "foreground": "#FF8F5A",
        "fontStyle": ""
      }
    },
    {
      "name": "JavaScript attributes and properties",
      "scope": [
        "source.js variable.other.property",
        "source.js variable.other.object.property",
        "source.jsx variable.other.property",
        "source.jsx variable.other.object.property"
      ],
      "settings": {
        "foreground": "#36D3FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Python base text and variables",
      "scope": [
        "source.python",
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#DCDEF2",
        "fontStyle": ""
      }
    },
    {
      "name": "Python keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#D16BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Python functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#6E8BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "Python parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#FF8F5A",
        "fontStyle": ""
      }
    },
    {
      "name": "Python attributes and properties",
      "scope": [
        "variable.other.object.property",
        "meta.attribute.python"
      ],
      "settings": {
        "foreground": "#36D3FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Python strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#2BEE7A",
        "fontStyle": ""
      }
    },
    {
      "name": "Python numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#FF9340",
        "fontStyle": ""
      }
    },
    {
      "name": "Python language constants",
      "scope": [
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#00F0FF",
        "fontStyle": ""
      }
    },
    {
      "name": "Python operators and punctuation",
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#FF8F5A",
        "fontStyle": ""
      }
    },
    {
      "name": "Python comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7479A3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python built-in types",
      "scope": [
        "support.type.python"
      ],
      "settings": {
        "foreground": "#FF4FB8",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL data types",
      "scope": [
        "storage.type.sql",
        "support.type.sql",
        "keyword.type.sql",
        "storage.type.numeric.sql",
        "storage.type.string.sql"
      ],
      "settings": {
        "foreground": "#FF9A2E",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL keywords",
      "scope": [
        "source.sql keyword",
        "keyword.other.sql",
        "keyword.control.sql"
      ],
      "settings": {
        "foreground": "#D16BFF",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL table names",
      "scope": [
        "source.sql constant.other.table-name"
      ],
      "settings": {
        "foreground": "#DCDEF2",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL columns",
      "scope": [
        "source.sql variable.other",
        "source.sql meta.column"
      ],
      "settings": {
        "foreground": "#1EF2D4",
        "fontStyle": ""
      }
    },
    {
      "name": "SQL functions",
      "scope": [
        "source.sql support.function"
      ],
      "settings": {
        "foreground": "#6E8BFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "TypeScript keywords",
      "scope": [
        "source.ts keyword",
        "source.ts storage.type",
        "source.ts storage.modifier",
        "source.tsx keyword",
        "source.tsx storage.type",
        "source.tsx storage.modifier"
      ],
      "settings": {
        "foreground": "#D16BFF"
      }
    },
    {
      "name": "Control flow (italic accent)",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop"
      ],
      "settings": {
        "foreground": "#FF4F9A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Class and type names",
      "scope": [
        "entity.name.type",
        "entity.name.type.alias",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "#FFD23F"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#FF4FB8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#FF3D6E"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#1EF2D4"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#FFD23F"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "meta.mapping.key string.quoted"
      ],
      "settings": {
        "foreground": "#36D3FF"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#FF3D6E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FFA132",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D16BFF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown inline code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#2BEE7A"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#4FA3FF"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#8D92B8"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#FFD23F",
    "enum": "#FFD23F",
    "function": "#6E8BFF",
    "method": "#6E8BFF",
    "parameter": "#FF8F5A",
    "property": "#36D3FF",
    "variable": "#DCDEF2",
    "keyword": "#D16BFF",
    "string": "#2BEE7A",
    "number": "#FF9340",
    "comment": {
      "foreground": "#7479A3",
      "italic": true
    },
    "type": "#FFD23F",
    "interface": "#FFD23F",
    "typeParameter": "#FFD23F",
    "namespace": "#36D3FF",
    "enumMember": "#00F0FF",
    "decorator": {
      "foreground": "#FF4FB8",
      "italic": true
    },
    "macro": "#FF4FB8",
    "variable.readonly": "#00F0FF"
  }
}
